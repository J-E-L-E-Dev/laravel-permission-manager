includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan/config.php

parameters:
    level: 5
    paths:
        - src
        - config
        - database/migrations
        - routes
    tmpDir: .phpstan.cache
    # modelKeys() hidrata intencionalmente los modelos configurados y respeta sus casts y scopes.
    noUnnecessaryCollectionCall: false
    ignoreErrors:
        # Model es el tipo público del parámetro; Models::user valida HasRoles en ejecución.
        # Estos cuatro métodos del trait no pueden expresarse mediante una intersección nativa de PHP con un trait.
        -
            message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::(roles|permissions|syncRoles|syncPermissions)\(\)\.$#'
            identifier: method.notFound
            path: src/*
