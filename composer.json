{
  "name": "ahinest/laravel-permission-manager",
  "description": "Explicit, transactional role hierarchy and permission delegation for Laravel and Spatie Permission.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/validation": "^12.0",
    "spatie/laravel-permission": "^6.25",
    "ext-pdo": "*",
    "ext-filter": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.8",
    "laravel/pint": "^1.24",
    "phpstan/phpstan": "^2.2.16",
    "larastan/larastan": "^3.12.2"
  },
  "autoload": {
    "psr-4": {
      "Ahinest\\LaravelPermissionManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ahinest\\LaravelPermissionManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Ahinest\\LaravelPermissionManager\\PermissionManagerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "format": "pint",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test:mariadb": "php tests/Support/run-mariadb.php"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}