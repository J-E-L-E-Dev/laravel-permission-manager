  {
    "path": "tests/Feature/DelegationPolicyHttpTest.php",
    "sha256": "84db41ad28379a9b2d206f8b10eb52f66dcdb1b4e5703fd3c245edae8a130b41",
    "lines": 434,
    "public_methods": [],
    "test_cases": [
      "does not borrow foreign guard admin hierarchy when projecting consumer members",
      "provides contextual role replacement candidates while preserving the general catalog",
      "does not grant contextual user capabilities from policy manager status alone",
      "blocks multistep authority fabrication while allowing valid admin intervention",
      "rejects own ordinary consumer mutations even without a sensitive role identity",
      "rolls back sync and metadata when persistence fails after authorization",
      "rolls back a role policy association if the save fails",
      "keeps shared association changes local to the affected consumer",
      "treats an inactive admin-loaded permission as protected dormant authority",
